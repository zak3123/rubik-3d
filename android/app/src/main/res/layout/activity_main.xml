<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 3D OpenGL View -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Container: Mode Tabs + HUD Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:orientation="vertical">

        <!-- Mode Navigation Tabs + Settings Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTabPlay"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/tab_play"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTabAlgo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/tab_algo"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTabLearn"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/tab_learn"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnTabSolve"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/tab_solve"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_primary"
                android:text="⚙"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Play Mode HUD -->
        <LinearLayout
            android:id="@+id/layoutPlayHUD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/timer_default"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMoves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moves: 0"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Algorithm Mode HUD -->
        <LinearLayout
            android:id="@+id/layoutAlgoHUD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAlgoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sexy Move"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlgoStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Step: 0 / 4"
                android:textColor="@color/accent_glow"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tutorial Mode HUD -->
        <LinearLayout
            android:id="@+id/layoutLearnHUD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLearnStage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1: Cross"
                    android:textColor="@color/accent_glow"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLearnTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="White Cross"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLearnStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Step: 0 / 6"
                android:textColor="@color/accent_glow"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- Solver Mode HUD -->
        <LinearLayout
            android:id="@+id/layoutSolveHUD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSolveTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kociemba Two-Phase"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSolveStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Step: 0 / 0"
                android:textColor="@color/accent_glow"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Solved Notification Banner -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_panel"
        android:text="@string/status_solved"
        android:textColor="@color/face_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom Container: Free Play Dock -->
    <LinearLayout
        android:id="@+id/layoutPlayControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnScramble"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="@string/action_scramble"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="@string/action_reset"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bottom Container: Algorithm Runner Dock -->
    <LinearLayout
        android:id="@+id/layoutAlgoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Row 1: Presets Spinner -->
        <Spinner
            android:id="@+id/spinnerPresets"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input" />

        <!-- Row 2: Custom Formula input + Load button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etAlgoInput"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/algo_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAlgoLoad"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/btn_primary"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/algo_load"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Row 3: Move Sequence with Step Highlight -->
        <HorizontalScrollView
            android:id="@+id/scrollAlgoMoves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvAlgoMovesDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text="R  U  R\'  U\'"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </HorizontalScrollView>

        <!-- Row 4: Playback Controls (Prev, Play/Pause, Next, Reset) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAlgoPrev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_prev"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAlgoPlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.2"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_play"
                android:textAllCaps="false"
                android:textColor="@color/accent_glow"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAlgoNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_next"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAlgoReset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_reset"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Container: Tutorial Runner Dock -->
    <LinearLayout
        android:id="@+id/layoutLearnControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Row 1: Lesson Spinner -->
        <Spinner
            android:id="@+id/spinnerLessons"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input" />

        <!-- Row 2: Lesson Explanation & Intuition card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLearnDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deskripsi tutorial"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLearnTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tips langkah"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 3: Move Sequence with Step Highlight -->
        <HorizontalScrollView
            android:id="@+id/scrollLearnMoves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvLearnMovesDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text="F  R  U  R\'  U\'  F\'"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </HorizontalScrollView>

        <!-- Row 4: Playback Controls (Prev, Demo/Pause, Next, Setup, Reset) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLearnPrev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_prev"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLearnPlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1.2"
                android:background="@drawable/btn_primary"
                android:text="@string/learn_demo_play"
                android:textAllCaps="false"
                android:textColor="@color/accent_glow"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLearnNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_next"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLearnSetup"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/btn_primary"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/learn_setup_btn"
                android:textAllCaps="false"
                android:textColor="@color/face_yellow"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLearnReset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_reset"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Bottom Container: Solver Dock -->
    <LinearLayout
        android:id="@+id/layoutSolveControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Row 1: Execute Solve button -->
        <Button
            android:id="@+id/btnSolveExecute"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_primary"
            android:text="@string/solve_action_btn"
            android:textAllCaps="false"
            android:textColor="@color/accent_glow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Row 2: Status label -->
        <TextView
            android:id="@+id/tvSolveInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Tekan tombol untuk menghitung solusi dari kubus saat ini"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Row 3: Move Sequence with Step Highlight -->
        <HorizontalScrollView
            android:id="@+id/scrollSolveMoves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvSolveMovesDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </HorizontalScrollView>

        <!-- Row 4: Playback Controls (Prev, Auto Play/Pause, Next, Reset) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSolvePrev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_prev"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSolvePlay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.2"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_play"
                android:textAllCaps="false"
                android:textColor="@color/accent_glow"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSolveNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_next"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSolveReset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_primary"
                android:text="@string/algo_reset"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Settings Overlay Modal -->
    <FrameLayout
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0D12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Sound switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:checked="true"
                android:text="@string/sound_enabled"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Volume slider -->
            <TextView
                android:id="@+id/tvVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volume: 70%"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:max="100"
                android:progress="70" />

            <!-- Animation speed slider -->
            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: 180 ms"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:max="450"
                android:progress="130" />

            <!-- Close button -->
            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_primary"
                android:text="@string/action_close"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
